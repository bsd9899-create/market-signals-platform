# انسخ هذا الملف إلى .env واملأ القيم المطلوبة.
# لا تضع أي قيمة حساسة (مفاتيح/كلمات مرور) مباشرة في الكود - كل شيء
# سرّي يُقرأ من .env فقط عبر app/infrastructure/config/loader.py.

# ---- بيئة التشغيل ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- قاعدة البيانات ----
# اختياري: إذا تُرك فارغاً/محذوفاً، يُستخدم SQLite افتراضياً داخل data/app.db.
# للتبديل لاحقاً إلى PostgreSQL مثلاً: DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# ---- Telegram ----
# TELEGRAM_BOT_TOKEN: توكن البوت من @BotFather.
# TELEGRAM_CHAT_ID: يُستخدَم من send_test_message.py وRealTelegramSender
# (راجع app/infrastructure/telegram/real_sender.py) - إرسال حقيقي فعلي.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_ADMIN_CHAT_ID: محجوز لاستخدام TelegramService الداخلي
# (لا يزال يستخدم LoggingTelegramSender افتراضياً - بلا اتصال حقيقي).
TELEGRAM_ADMIN_CHAT_ID=
