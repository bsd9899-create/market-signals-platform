# انسخ هذا الملف إلى .env واملأ القيم الحقيقية. لا تضع أي قيمة سرية
# مباشرة في الكود أو تُدرجها في Git — .env مستثنى في .gitignore.
#
# المتغيرات بادئتها EXPO_PUBLIC_ لأنها تُضمَّن في حزمة التطبيق نفسها
# (يجب أن تكون قيمًا آمنة للنشر العلني فقط — مثل anon key العام لـ
# Supabase الذي يعتمد أمانه على RLS، وليس على إخفائه).

# ---- Supabase ----
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---- RevenueCat (تُضاف عند المرحلة 9) ----
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
